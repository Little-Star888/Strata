# Keep the image to the source only: everything generated is re-created on
# first start (inside the container or on the /data volume).
.git

# local Python environment (rebuilt in the image)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# setup.py outputs and downloads (engine, packs, models, logs)
/engine/
/build/
/build*/
/dist/
/packs/
/mtp/
/models/
/Strata-data/
# cn deployment (deploy/v0.1.41-cn): third_party/llama.cpp is preplaced at the pinned
# commit so the build needs no network. Upstream excludes it and downloads the zip
# from github inside the build, which times out on this host (its build-sandbox
# network cannot reach github even though the host can).
# third_party/llama.cpp/
third_party/*.zip
*.done
*.log
strata-*.json
strata-*.txt
run-*.sh
run-*.bat
