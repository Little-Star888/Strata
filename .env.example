# cn 部署配置模板(deploy/v0.1.44.1-cn)。复制为 .env 后填写;真实密钥写在这里没问题,
# 此文件不入 git(/.env 已在 .gitignore)。

# 模型档位。已有配置(随 models/ 从 fork 部署移来,秒切)的档位:
#   IQ3_S | UD-IQ4_XS | UD-Q4_K_XL | NVFP4 | NVFP4-MIX | NVFP4-Q8
# 需 setup 首次安装下载的档位(UD-Q5/Q6/Q8_0 与 Qwen3.6 各档 RAM 需求见 docs/QUANTS.md):
#   NVFP4-NVIDIA | UD-Q5_K_XL | UD-Q6_K_XL | Q8_0 | Qwen3.6-35B-A3B 各档
MODEL=NVFP4

# 上下文长度。仅在新装档位生成配置时生效;已配档位改这个需配 REINSTALL=1 一次。
# 524288 = 512K(yarn×2 引擎自动配)。≤262144 无需 RoPE 扩展。
CONTEXT=524288

# 视觉(图像理解):yes 开启 | no 关闭 | cpu 编码器走 CPU。修改已配档位需配 REINSTALL=1 一次。
VISION=yes

# 无审查开关:on 注入去审查控制向量(层 8-33,权重不动;web 面板与 API 的 uncensored
# 字段可按请求切换)。对"新装档位"在生成配置时注入;"已配档位"的向量已烧在配置里,
# 改 off 时把 .env 改为 off 并配 REINSTALL=1 一次(会重生成配置、去掉向量参数)。
# 注意:REINSTALL 重生成会按本文件重写该档位的全部设置。
UNCENSORED=on

# API 密钥:端口发布在 0.0.0.0,必须设置(AGENTS.md)。改已配档位的密钥需配 REINSTALL=1 一次。
API_KEY=change-me

# 宿主机端口(Compose v2.30+,gpus: all 需要它)
HOST_PORT=8089

# 下载源:modelscope(国内直连)或 huggingface/auto
STRATA_SOURCE=modelscope

# ── 以下一般不动 ────────────────────────────────────────────────
# REINSTALL=1:一次性开关,仅在改动已装档位的设置(上下文/视觉/密钥)的那次 up 前临时
# 加上,启动成功后删掉(否则每次重启都重跑 setup,又慢又依赖网络)。
#REINSTALL=1

# 0.1.43 的自适应重叠解码(默认关,桌面卡有 -19~-21% 的历史案例,0.1.43.1 修了根因;
# 开启前先 A/B:本机 5090 桌面属上游实测 +1-2% 的受益类)
#STRATA_ADAPT_OVERLAP=1

# UD-Q4/Q5/Q6_K_XL 的 K 量化 prompt 内核(上游实测 AMD 上 prompt ×1.3-1.7,NVIDIA 待测;
# 有未判定的 prompt 路径 KL 变化,故 opt-in。开前建议 A/B)
#STRATA_MMQ_KQ=1

# 路由尾跳:NVFP4 各档默认关(掉质量);其余档上游自动。一般不动。
#STRATA_ROUTE_TAIL_SKIP=

PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
