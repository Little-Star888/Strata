# 复制为 .env 后按需修改;`docker compose` 会自动读取。
# 每个参数与 README 的 docker run 环境变量一一对应(docker-entrypoint.sh 解析)。
# 改完执行 `docker compose up -d` 生效(自动重建容器,模型在卷上不会重下)。

# ---------- 常用 ----------

# 模型档位。可选:Q2_0 | IQ2_XS | IQ3_XXS | IQ3_S(通用档,推荐)
#   UD-IQ4_XS | UD-Q4_K_XL(质量更高,速度更慢;必须同时设 FAMILY=unsloth)
MODEL=IQ3_S

# 模型家族:原装档(Qwen)留空即可;Unsloth 档(UD-IQ4_XS / UD-Q4_K_XL)必须设 unsloth。
#FAMILY=unsloth

# 上下文长度(token)。262144 是模型训练最大值,原生支持;
#   393216 / 524288 会自动加 yarn RoPE 外推(实验性,见 docs/DETAILS.md)。
#   注意:修改已安装档位的上下文,需要临时加 REINSTALL=1(用完删掉)。
CONTEXT=262144

# 一次性开关:设为 1 时本次 up 会重跑 setup(用于修改已装档位的上下文/Vision/KV/
#   API_KEY 等设置)。生效后删除此行再 up 一次;平时保持注释。
#REINSTALL=1

# ---------- 下载与 Python 源(国内环境,保持不动) ----------

# 模型下载源:modelscope(魔搭,国内可达)| huggingface | auto。
#   该主机 hf-mirror 不可达,保持 modelscope。
STRATA_SOURCE=modelscope
# setup 运行期补装 Python 包用的 pip 源。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------- 可选(按需取消注释) ----------

# 图像理解(视觉编码器已在镜像内):no 关闭 | yes 开启 | cpu 用 CPU 跑编码器。
#   开启/关闭属于模型设置,需配合 REINSTALL=1 生效一次。
#VISION=no

# KV 缓存精度:int8(默认,所有公开数字的测量口径)| q4_0(省一半,长文查询仍通过)|
#   k8v4。修改需配合 REINSTALL=1。
#KV=

# KV 流式(上下文超长时把 KV 缓存放进内存):auto | on | off。留空用引擎默认。
#KV_STREAMING=

# 显卡选择:GPU=0 指定单卡;GPUS=0,1 多卡按层切分(需大显存场景);留空=自动。
#GPU=
#GPUS=
# 多卡切层的分层点(配合 GPUS 使用,留空自动)。
#LAYER_SPLIT=

# 低内存模式:auto | on | off。本机 128GB 内存用不到 on,保持 auto。
#LOW_RAM=

# UD-Q4_K_XL 的专家内存驻留预算(GiB)。留空 = setup 按内存自动算(本机为 71)。
#RESIDENT_BUDGET_GIB=

# API 密钥:设置后所有对话请求都要携带它(浏览器会弹出输入框)。
#   安全规则:端口映射只要超出 127.0.0.1(改 docker-compose.yml 的 ports),
#   就必须先设置它(AGENTS.md)。修改需配合 REINSTALL=1 生效一次。
#API_KEY=

# ---------- 高级(一般不用;需先在 docker-compose.yml 加对应挂载) ----------

# 用已有的 GGUF 文件启动(跳过下载):容器内路径,须先在 docker-compose.yml 的
#   volumes 里把宿主机目录挂进容器,再指向它。
#GGUF_DIR=

# 直接指定启动配置文件(容器内路径,覆盖 MODEL 对应的配置)。同样需要挂载。
#CONFIG=

# ---------- 不建议修改 ----------

# 容器内监听地址/端口。HOST 必须保持 0.0.0.0(端口映射依赖它);
#   PORT 改动必须与 docker-compose.yml 的 ports 保持一致,通常两个都别动。
#HOST=0.0.0.0
#PORT=8080
