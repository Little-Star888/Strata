# Copy to .env and edit. `docker compose` reads it automatically.
# Every switch is the same env var the README's docker run takes.

# The model size. unsloth tiers (UD-IQ4_XS, UD-Q4_K_XL) also need FAMILY=unsloth.
MODEL=IQ3_S
#FAMILY=unsloth

# Context tokens. 262144 is the model's trained maximum. Changing it on an
# installed model needs REINSTALL=1 for the one up that applies it.
CONTEXT=262144
#REINSTALL=1

# Where model files come from (modelscope = reachable from mainland China).
STRATA_SOURCE=modelscope
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- optional, uncomment to use -------------------------------------------
# Pin one card: GPU=0, or name several for a layer split: GPUS=0,1
#GPU=
#GPUS=
# KV cache: int8 (default) | q4_0 | k8v4
#KV=
# API key: required before changing the port mapping past 127.0.0.1 (AGENTS.md)
#API_KEY=
